# Capability -> model. The container reads these at boot; copy this file to
# components.env (or pass COMPONENT_* variables) only to point a capability elsewhere.
# The defaults below are what the hosted interfaze-1-lite runs.
COMPONENT_BRAIN=Qwen/Qwen3.8-27B-FP8
COMPONENT_OCR_VLM=dots-studio/dots.mocr
COMPONENT_ASR_FALLBACK=openai/whisper-large-v3-turbo
COMPONENT_DIARIZER=pyannote/speaker-diarization-community-1
COMPONENT_SEGMENTER=facebook/sam2.1-hiera-large
COMPONENT_LAYOUT=PP-DocLayout_plus-L
COMPONENT_LINE_DETECTOR=PaddlePaddle/PP-OCRv5_server_det
COMPONENT_LINE_RECOGNIZER=PaddlePaddle/en_PP-OCRv5_mobile_rec
COMPONENT_GUARD=Qwen/Qwen3Guard-Gen-0.6B
COMPONENT_FORECASTER=google/timesfm-2.5-200m-pytorch
# Optional: a faster English ASR path, used only with ENABLE_FAST_ASR=1.
# COMPONENT_ASR=nvidia/parakeet-tdt-0.6b-v3
